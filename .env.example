# Supabase project (Settings > API). Use the service_role key: this is a trusted backend.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared secret for the admin HTTP API (sent as `x-api-key` header).
# Generate one: openssl rand -hex 32
ADMIN_API_KEY=
PORT=3000

# Where per-tenant WhatsApp credentials are stored on disk
AUTH_DIR=./auth

# Reply behaviour
HISTORY_LIMIT=20
KB_MATCH_COUNT=6
KB_MATCH_THRESHOLD=0.35
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LOG_LEVEL=info
