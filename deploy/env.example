# Zeveto bot env — copy to /opt/zeveto/.env on the server, fill in real values.
# chmod 600 it. Never commit the real file.

# --- required ---
SUPABASE_URL=https://yaydvzmsoevydyqrgnfw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
GROQ_API_KEY=<groq key>
ADMIN_API_KEY=<openssl rand -hex 32 — same value goes into Vercel as BOT_API_KEY>

# --- server ---
PORT=8080
LOG_LEVEL=info
# Baileys session storage. MUST be a persistent path — losing it = re-pair WhatsApp.
AUTH_DIR=/opt/zeveto/auth

# --- optional (defaults shown) ---
# GROQ_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# KB_MATCH_THRESHOLD=
# KB_MATCH_COUNT=
# HISTORY_LIMIT=
